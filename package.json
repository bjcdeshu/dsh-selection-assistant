{
  "name": "dsh-selection-assistant",
  "version": "0.1.0",
  "description": "Windows 全局划词助手：Cherry 同款 selection-hook 取词，复用 DSH 模型进行翻译、解释与总结。",
  "type": "module",
  "main": "src/index.js",
  "exports": { ".": "./src/index.js", "./package.json": "./package.json" },
  "files": ["src", "native", "scripts/build-native.mjs", "dist/native", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build:native": "node scripts/build-native.mjs",
    "demo": "node scripts/demo.mjs",
    "verify": "node scripts/check.mjs && node --test test/*.test.mjs"
  },
  "engines": { "node": ">=22.19.0" },
  "dependencies": { "selection-hook": "2.1.1" },
  "peerDependencies": { "@deepseek-ai/dsh-llm": "0.2.0-rc.2" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-llm": { "optional": true } },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "keywords": ["dsh-plugin", "deepseek-harness", "selection-hook", "translation", "windows"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/bjcdeshu/dsh-selection-assistant.git" },
  "bugs": { "url": "https://github.com/bjcdeshu/dsh-selection-assistant/issues" }
}
